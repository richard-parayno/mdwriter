#!/usr/bin/env bash
# Prepares an Amp orb (Debian 12) to build, test and headlessly render mdwriter: the libraries
# Rune's window and GPU layers load on Linux, and the Rust toolchain pinned in .tool-versions.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - start))s)"
}

apt_packages=(
  build-essential
  curl
  pkg-config
  # winit links these for keyboard input and Wayland windows.
  libxkbcommon-dev
  libwayland-dev
  # Font discovery.
  libfontconfig1-dev
  # A software Vulkan driver (lavapipe): the orb has no GPU, and `--snap` renders through wgpu.
  mesa-vulkan-drivers
)

install_apt_packages() {
  local missing=()
  local pkg
  for pkg in "${apt_packages[@]}"; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" || missing+=("$pkg")
  done
  if ((${#missing[@]} == 0)); then
    echo "all apt packages present"
    return
  fi
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
}

mise_bin="$HOME/.local/bin/mise"
mise_shims="$HOME/.local/share/mise/shims"

install_mise() {
  if [[ -x "$mise_bin" ]]; then
    "$mise_bin" --version
    return
  fi
  curl -fsSL https://mise.run | MISE_QUIET=1 sh
}

persist_shell_environment() {
  local marker="# mdwriter: mise toolchain from .tool-versions"
  if grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    echo "~/.bash_profile already configured"
    return
  fi
  cat >>"$HOME/.bash_profile" <<EOT

$marker
case ":\$PATH:" in
  *":$mise_shims:"*) ;;
  *) export PATH="$HOME/.local/bin:$mise_shims:\$PATH" ;;
esac
EOT
}

export PATH="$HOME/.local/bin:$mise_shims:$PATH"

step "apt packages" install_apt_packages
step "mise" install_mise
step "toolchain (.tool-versions)" "$mise_bin" install --yes
step "shell environment" persist_shell_environment
# Builds Rune and the app once, so `cargo test` and `cargo run` start quickly. One job at a
# time: linking Rune's dependencies in parallel needs more memory than a small orb has.
step "cargo build" cargo build --jobs 2
step "cargo test build" cargo test --no-run --jobs 2
